{
  "name": "penaguru-dashboard-app",
  "version": "1.0.0",
  "description": "Mobile teacher dashboard (PenaGuru) built with React Native for student management and grading.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export -p web && node scripts/copy-showcase.js",
    "build:web": "expo export -p web && node scripts/copy-showcase.js",
    "export:android": "expo export -p android",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:release": "cd android && .\\gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:apk:debug": "cd android && .\\gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/akbarimron/Penaguru-dashboard-app"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "^2.117.3",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.30",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": []
      }
    }
  }
}
