# Konfigurasi Supabase PenaGuru
# Tanpa dua nilai ini aplikasi berjalan di mode demo (data contoh di perangkat).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Isi "true" setelah Edge Function Gemini (pedagogy-assistant, generate-feedback)
# di-deploy. Bila kosong, asisten memakai bank saran lokal yang diberi label.
EXPO_PUBLIC_AI_EDGE_FUNCTIONS=
